                    "wrapper": { "width": "40" }
                },
                {
                    "key": "field_is_heading",
                    "label": "Heading",
                    "name": "heading",
                    "type": "text",
                    "required": 0,
                    "wrapper": { "width": "60" }
                },
                {
                    "key": "field_is_subheading",
                    "label": "Subheading",
                    "name": "subheading",
                    "type": "text",
                    "required": 0,
                    "wrapper": { "width": "40" }
                },
                {
                    "key": "field_is_tertiary_heading",
