            "insert": "append",
            "library": "all"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/image-carousel"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "show_in_graphql": 1,
    "graphql_field_name": "imageCarousel",
    "map_graphql_types_from_location_rules": 0,
    "graphql_types": [
        "AcfImageCarousel"
    ]
}
