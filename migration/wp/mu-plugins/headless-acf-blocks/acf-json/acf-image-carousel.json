{
    "key": "group_image_carousel",
    "title": "Image Carousel Fields",
    "fields": [
        {
            "key": "field_ic_title",
            "label": "Title",
            "name": "title",
            "type": "text",
            "instructions": "Optional. Shown above the carousel (e.g. \"Featured In\").",
            "required": 0
        },
        {
            "key": "field_ic_background_variant",
            "label": "Background",
            "name": "background_variant",
            "type": "button_group",
            "instructions": "Default keeps the page background. Featured bar draws the full width teal band.",
            "choices": {
                "default": "Default",
                "featured_bar": "Featured bar"
            },
            "default_value": "default",
            "return_format": "value",
            "allow_null": 0,
            "required": 0
        },
        {
            "key": "field_ic_images",
            "label": "Images",
            "name": "images",
            "type": "gallery",
            "instructions": "Logos\/images shown in the carousel. Drag to reorder. Carousel behaviour (autoplay, loop, slides per view) is fixed by the frontend.",
            "return_format": "array",
            "preview_size": "medium",
            "insert": "append",
            "library": "all"
        },
        {
            "key": "field_ic_link",
            "label": "Link",
            "name": "link",
            "type": "link",
            "instructions": "Optional. Shown as a \"Learn more\" button below the carousel, or makes the whole carousel clickable — pick below.",
            "required": 0
        },
        {
            "key": "field_ic_link_style",
            "label": "Link Style",
            "name": "link_style",
            "type": "button_group",
            "instructions": "Only applies when a link is set above.",
            "choices": {
                "button": "Learn more button",
                "whole_carousel": "Whole carousel clickable"
            },
            "default_value": "button",
            "conditional_logic": [
                [
                    {
                        "field": "field_ic_link",
                        "operator": "!=empty"
                    }
                ]
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/image-carousel"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "show_in_graphql": 1,
    "graphql_field_name": "imageCarousel",
    "map_graphql_types_from_location_rules": 0,
    "graphql_types": [
        "AcfImageCarousel"
    ]
}
