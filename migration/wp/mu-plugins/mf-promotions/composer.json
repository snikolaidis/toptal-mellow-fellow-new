{
    "name": "mellowfellow/promotions-engine",
    "description": "Deterministic, framework-independent promotion engine core for Mellow Fellow.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MellowFellow\\Promotions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MellowFellow\\Promotions\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.29"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
