# WordPress Configuration (WPEngine)
NEXT_PUBLIC_WORDPRESS_URL=https://your-site.wpengine.com
FAUST_SECRET_KEY=your-faust-secret-key-here

# WPGraphQL Endpoint (usually /graphql)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/graphql

# Authorize.net Configuration (Sandbox)
# Get these from your Authorize.net sandbox account
NEXT_PUBLIC_AUTHORIZE_API_LOGIN_ID=your-api-login-id
NEXT_PUBLIC_AUTHORIZE_CLIENT_KEY=your-client-key
AUTHORIZE_TRANSACTION_KEY=your-transaction-key

# Set to 'sandbox' for testing, 'production' for live
NEXT_PUBLIC_AUTHORIZE_ENVIRONMENT=sandbox

# Authorize.net Webhook Signature Key
# Get this from Authorize.net Merchant Interface > Account > Settings > Webhooks
AUTHORIZE_SIGNATURE_KEY=your-webhook-signature-key

# Storage Configuration
# Type: 'sqlite' (development) or 'redis' (production/Railway)
STORAGE_TYPE=redis

# Redis Configuration (Railway provides this automatically)
REDIS_URL=redis://localhost:6379

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-railway-app.up.railway.app
NEXT_PUBLIC_SITE_NAME=My WooCommerce Store
