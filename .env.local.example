# WordPress Configuration (WPEngine)
NEXT_PUBLIC_WORDPRESS_URL=https://your-site.wpengine.com
FAUST_SECRET_KEY=your-faust-secret-key-here

# WPGraphQL Endpoint (usually /graphql)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/graphql

# Authorize.net Configuration (Sandbox)
# Get these from your Authorize.net sandbox account
NEXT_PUBLIC_AUTHORIZE_API_LOGIN_ID=your-api-login-id
NEXT_PUBLIC_AUTHORIZE_CLIENT_KEY=your-client-key
AUTHORIZE_TRANSACTION_KEY=your-transaction-key

# Set to 'sandbox' for testing, 'production' for live
NEXT_PUBLIC_AUTHORIZE_ENVIRONMENT=sandbox

# Authorize.net Webhook Signature Key
# Get this from Authorize.net Merchant Interface > Account > Settings > Webhooks
AUTHORIZE_SIGNATURE_KEY=your-webhook-signature-key

# Storage Configuration
# Type: 'sqlite' (development) or 'redis' (production/Railway)
STORAGE_TYPE=redis

# Redis Configuration (Railway provides this automatically)
REDIS_URL=redis://localhost:6379

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-railway-app.up.railway.app
NEXT_PUBLIC_SITE_NAME=My WooCommerce Store

# Shopify Admin API (for migration scripts only, server-side, never exposed)
# Get Client ID and Secret from Dev Dashboard, Apps, your app, Settings, Credentials
# Script exchanges these for a 24h access token via OAuth client credentials grant
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
SHOPIFY_API_VERSION=2026-04

# WooCommerce REST API (server-side, for migration scripts and server flows)
WC_API_URL=https://your-site.wpenginepowered.com/wp-json/wc/v3
WC_CONSUMER_KEY=ck_xxx
WC_CONSUMER_SECRET=cs_xxx

# WordPress REST API (server-side, for ACF, CPTs, pages)
WP_API_URL=https://your-site.wpenginepowered.com
WP_API_USER=your-wp-admin-username
WP_API_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Rebuy (server only, keep it out of the browser)
REBUY_API_KEY=your-rebuy-api-key

# Yotpo Reviews (app key is public, secret stays on the server)
NEXT_PUBLIC_YOTPO_APP_KEY=your-yotpo-app-key
YOTPO_API_SECRET=your-yotpo-secret

# Yotpo Loyalty / Mellow Moolah
# Loader: paste the exact on-site loader script src from the Yotpo Loyalty admin (On-Site Widgets)
NEXT_PUBLIC_YOTPO_LOYALTY_LOADER=
# NOTE: the loyalty API key is a SECRET and is NOT a Next.js/Railway env var.
# It is set in WordPress (wp-config.php: define('YOTPO_LOYALTY_API_KEY', '...')) and read by
# the mellow-fellow-loyalty-identity mu-plugin to sign the secure customer identification token.
# My Rewards widget instance id (loyalty panel rendered on the account page)
NEXT_PUBLIC_YOTPO_LOYALTY_MY_REWARDS_INSTANCE=
# Loyalty Page widget instance id (the standalone /pages/rewards page)
NEXT_PUBLIC_YOTPO_LOYALTY_PAGE_INSTANCE=
# Bonus points products page widgets (/pages/bonus-points-products)
NEXT_PUBLIC_YOTPO_LOYALTY_COUPONS_REDEMPTION_INSTANCE=
NEXT_PUBLIC_YOTPO_LOYALTY_VIP_TIERS_INSTANCE=
NEXT_PUBLIC_YOTPO_LOYALTY_REFERRAL_SHARE_INSTANCE=

# Klaviyo (public key for onsite tracking, private for server events)
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=your-klaviyo-public-key
KLAVIYO_PRIVATE_KEY=your-klaviyo-private-key

# Klaviyo deals/coupons embed form ID — dev uses TEST account; swap to Alpha Brands at cutover
NEXT_PUBLIC_KLAVIYO_DEALS_FORM_ID=your_6_character_form_id_here

# Awin Affiliate Tracking
NEXT_PUBLIC_AWIN_ADVERTISER_ID=59403

# Gravity Forms — form IDs (required; the form silently fails to submit without them)
# Each must match the top-level Form ID shown in WP Admin > Forms, and must also be set in
# Railway for production. Form IDs can differ between WP environments — check, don't assume.
# Contact Us page form (/pages/contact-us)
NEXT_PUBLIC_CONTACT_FORM_ID=your-contact-form-id
# Press page form (/pages/mellow-press)
NEXT_PUBLIC_PRESS_CONTACT_FORM_ID=your-press-contact-form-id

# Meilisearch (product search index, BugHerd #231)
# Both keys are SECRETS — never expose them to the browser (no NEXT_PUBLIC_ prefix).
MEILISEARCH_HOST=http://localhost:7700
# Admin key: used only by POST /api/reindex to build the index.
MEILISEARCH_ADMIN_KEY=your-meilisearch-admin-key
# Search-only key: used by /api/search and the search results page. Mint it from the
# master key scoped to the products index (actions: ["search"]). DEPLOY NOTE: production
# needs its own scoped search key, minted from the prod master key once Meilisearch's
# prod host is decided — do not reuse this local key.
MEILISEARCH_SEARCH_KEY=your-meilisearch-search-key
# Shared secret for POST /api/reindex, sent as the x-reindex-secret header
REINDEX_SECRET=change-me
